{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brick-game-integration-test",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "vars": { "ENABLE_RANKED": "true", "ENABLE_LEADERBOARD_WS": "true" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brick-game-test-db",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "worker/migrations"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "LEADERBOARD_HUB", "class_name": "LeaderboardHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeaderboardHub"] }],
  "triggers": { "crons": ["17 * * * *"] },
  "ratelimits": [
    { "name": "START_LIMIT", "namespace_id": "9001", "simple": { "limit": 1000, "period": 60 } },
    { "name": "FINISH_LIMIT", "namespace_id": "9002", "simple": { "limit": 1000, "period": 60 } },
    { "name": "CLAIM_LIMIT", "namespace_id": "9003", "simple": { "limit": 1000, "period": 60 } },
    { "name": "WS_LIMIT", "namespace_id": "9004", "simple": { "limit": 1000, "period": 60 } }
  ]
}
